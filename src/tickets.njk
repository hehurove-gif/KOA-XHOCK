---
permalink: tickets.html
---
{% from "macros.njk" import titleLines, buyButton %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>document.documentElement.classList.add('js');window.dataLayer=window.dataLayer||[];</script>
{%- if event.isOpen -%}
  {%- set pageTitle = "Buy XHOCK Tickets — Player Ticket {price} {currency} | KOA" -%}
  {%- set pageDescription = "Secure your XHOCK player ticket ({price} {currency}) for four days of international hockey at {venue}, {dates}. Register solo and we'll place you on a team." -%}
  {%- set shareTitle = "Buy XHOCK Tickets — Player Ticket {price} {currency}" -%}
  {%- set shareDescription = "Four days of international hockey at {venue}, {dates}. Register solo and we'll place you on a team." -%}
{%- else -%}
  {%- set pageTitle = "XHOCK Tickets — " + event.noticeTitle + " | KOA" -%}
  {%- set pageDescription = event.noticeText -%}
  {%- set shareTitle = event.noticeTitle -%}
  {%- set shareDescription = event.noticeText -%}
  {%- set noindex = true -%}
{%- endif -%}
{%- set pagePath = "tickets.html" -%}
{% include "seo.njk" %}

  <link rel="preload" href="assets/fonts/Orbitron-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="assets/fonts/Manrope-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="assets/css/styles.css" />
{% if event.isOpen %}
  <!-- Phone field enhancement. The page works without it: the input falls
       back to a plain tel field if the script is unavailable. Self-hosted. -->
  <link rel="stylesheet" href="assets/vendor/intl-tel-input/css/intlTelInput.min.css" />
  <script defer src="assets/vendor/intl-tel-input/js/intlTelInput.min.js"></script>
{% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "XHOCK", "item": "{{ site.url }}" },
      { "@type": "ListItem", "position": 2, "name": "Tickets", "item": "{{ "tickets.html" | absUrl }}" }
    ]
  }
  </script>
</head>
<body class="ticket-page">
{% include "noscript-analytics.njk" %}

  <a class="skip-link" href="#ticket-form">Skip to the ticket form</a>
  <noscript>
    <div class="noscript-banner" role="status">
      JavaScript is disabled in your browser. Checkout needs JavaScript.
      <a href="https://wa.me/{{ site.whatsappNumber }}?text=Hi%20KOA%2C%20I%27d%20like%20to%20buy%20a%20ticket%20for%20XHOCK">Buy your ticket on WhatsApp</a>.
    </div>
  </noscript>

  <header class="ticket-header">
    <div class="container ticket-header__inner">
      <a class="ticket-header__brand" href="index.html" aria-label="KOA XHOCK home">
        <img src="assets/logos/Logo-negativo.png" alt="KOA" width="104" height="38" />
        <span class="koa-tag">XHOCK</span>
      </a>
      <a class="ticket-header__back" href="index.html">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/></svg>
        Back to XHOCK
      </a>
    </div>
  </header>

{% if event.isOpen %}
  <main class="ticket-main" id="ticket-form" tabindex="-1">
    <div class="container ticket-layout">

      <aside class="ticket-summary" aria-label="Ticket summary">
        <p class="eyebrow">Tickets &amp; Registration</p>
        <h1 class="ticket-summary__title">Your spot on the <span>ice</span> starts here.</h1>
        <p class="ticket-summary__lead">
          One player ticket, four days of international hockey. Register on your own and XHOCK
          will place you on a team with players from Canada, the United States and Mexico.
        </p>

        <div class="ticket-summary__price">
          <strong>{{ event.priceLabel }}</strong>
          <span>{{ event.currency }} <em>per player</em></span>
        </div>

        <a class="ticket-summary__jump" href="#ticketFormTitle">
          Fill in my details
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></svg>
        </a>

        <ul class="ticket-summary__list">
          {%- for bullet in cms.home.tickets.bullets %}
          <li><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{{ bullet | fill }}</li>
          {%- endfor %}
        </ul>

        <dl class="ticket-summary__meta">
          <div>
            <dt>Dates</dt>
            <dd>{{ event.dateLabel }}, {{ event.year }}</dd>
          </div>
          <div>
            <dt>Venue</dt>
            <dd>{{ event.venue }}</dd>
          </div>
          <div>
            <dt>Order limit</dt>
            <dd>Up to 10 tickets</dd>
          </div>
        </dl>

        <p class="ticket-summary__note">
          Need help before you buy?
          <a href="https://wa.me/{{ site.whatsappNumber }}?text=Hi%20KOA%2C%20I%27d%20like%20more%20information%20about%20XHOCK" target="_blank" rel="noreferrer">Chat with KOA on WhatsApp</a>.
        </p>
      </aside>

      <section class="ticket-card" aria-labelledby="ticketFormTitle">
        <div class="ticket-modal__head ticket-card__head">
          <div class="ticket-modal__head-text">
            <span class="ticket-modal__event">XHOCK International Hockey Tournament</span>
            <div class="ticket-modal__meta">
              <span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="11" r="2.4"/></svg>{{ event.venue }}</span>
              <span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2.5"/><path d="M4 9.5h16"/><path d="M8 3v4M16 3v4"/></svg>{{ event.dateShort }}</span>
            </div>
            <h2 id="ticketFormTitle">Your Information</h2>
            <p class="ticket-modal__desc">{{ event.priceLabel }} {{ event.currency }} per player. Enter the contact details and the information for every player ticket.</p>
          </div>
        </div>

        <form class="ticket-modal__form ticket-card__form" id="ticketForm" action="{{ site.checkoutEndpoint }}" method="post" novalidate>
          <div class="ticket-modal__body" id="ticketFormBody">
            <div class="tm-section-label">Contact Information</div>
            <div class="tm-grid">
              <div class="tm-field">
                <label for="tmFirstName">First name</label>
                <input id="tmFirstName" name="firstName" type="text" placeholder="e.g. Maria" autocomplete="given-name" maxlength="60" required aria-describedby="err-tmFirstName" />
                <p class="tm-field__error" id="err-tmFirstName" hidden></p>
              </div>
              <div class="tm-field">
                <label for="tmLastName">Last name</label>
                <input id="tmLastName" name="lastName" type="text" placeholder="e.g. Gonzalez" autocomplete="family-name" maxlength="60" required aria-describedby="err-tmLastName" />
                <p class="tm-field__error" id="err-tmLastName" hidden></p>
              </div>
            </div>
            <div class="tm-grid">
              <div class="tm-field">
                <label for="tmEmail">Email address</label>
                <input id="tmEmail" name="email" type="email" placeholder="e.g. name@email.com" autocomplete="email" maxlength="254" inputmode="email" required aria-describedby="err-tmEmail" />
                <p class="tm-field__error" id="err-tmEmail" hidden></p>
              </div>
              <div class="tm-field">
                <label for="tmPhone">Phone number</label>
                <input id="tmPhone" name="phone" type="tel" autocomplete="tel" placeholder="55 1234 5678" maxlength="25" required aria-describedby="err-tmPhone" />
                <p class="tm-field__error" id="err-tmPhone" hidden></p>
              </div>
            </div>
            <div class="tm-grid">
              <div class="tm-field">
                <label for="tmCountry">Country</label>
                <select id="tmCountry" name="country" autocomplete="country-name" required aria-describedby="err-tmCountry">
                  <option value="" disabled selected>Select your country</option>
                  <option>Canada</option>
                  <option>United States</option>
                  <option>Mexico</option>
                  <option>Other</option>
                </select>
                <p class="tm-field__error" id="err-tmCountry" hidden></p>
              </div>
              <div class="tm-field">
                <label for="tmQty">Number of tickets</label>
                <div class="tm-stepper">
                  <button type="button" class="tm-stepper__btn" data-qty-step="-1" aria-label="Remove one ticket">−</button>
                  <input id="tmQty" name="quantity" type="number" min="1" max="10" step="1" value="1" inputmode="numeric" required aria-describedby="tmQtyHint err-tmQty" />
                  <button type="button" class="tm-stepper__btn" data-qty-step="1" aria-label="Add one ticket">+</button>
                </div>
                <p class="tm-hint" id="tmQtyHint">Maximum 10 tickets per order.</p>
                <p class="tm-field__error" id="err-tmQty" hidden></p>
              </div>
            </div>

            <div class="tm-players-wrap">
              <div class="tm-players__intro">
                <div class="tm-section-label">Player Information</div>
                <p>Complete the information for each player ticket. Player 1 is the ticket buyer.</p>
              </div>
              <div class="tm-players" id="tmPlayers"></div>
            </div>

            <input type="hidden" name="ticketType" value="Player Ticket" />
            <!-- Campaign attribution: UTMs, gclid, fbclid and friends. script.js reads
                 them from the URL, keeps them in localStorage and fills this block on
                 every submit, so a visitor who returns without the query string still
                 carries the campaign that brought them. -->
            <div data-attribution-fields hidden></div>
            <!-- Honeypot: hidden from people, irresistible to bots. Must stay empty. -->
            <div class="tm-hp" aria-hidden="true">
              <label for="tmCompany">Company</label>
              <input id="tmCompany" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="tm-checkbox">
              <input type="checkbox" id="tmTerms" name="terms" value="accepted" required aria-describedby="err-tmTerms" />
              <span><label for="tmTerms">I accept the</label> <a href="terms.html" target="_blank" rel="noopener">Terms &amp; Conditions</a> <label for="tmTerms">and the</label> <a href="privacy.html" target="_blank" rel="noopener">Privacy Policy</a>.</span>
            </div>
            <p class="tm-field__error" id="err-tmTerms" hidden></p>
          </div>

          <div class="ticket-modal__foot ticket-card__foot">
            <p class="tm-error" id="tmError" role="alert" hidden></p>
            {% if site.turnstileSiteKey %}
            <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-theme="dark" data-language="en"></div>
            {% endif %}

            <button class="btn btn--primary btn--full magnetic" type="submit">
              <span class="tm-submit__label">Continue to Payment</span>
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </button>
            <p class="tm-note">Secure payments powered by Stripe. You will be redirected to the payment page.</p>
          </div>
        </form>
      </section>

    </div>
  </main>
{% else %}
  <main class="ticket-main" id="ticket-form" tabindex="-1">
    <div class="container ticket-closed">
      <p class="eyebrow">{{ event.name }}</p>
      <h1 class="ticket-summary__title">{{ event.noticeTitle | fill }}</h1>
      <p class="ticket-summary__lead">{{ event.noticeText | fill }}</p>
      <p>
        <a class="btn btn--primary magnetic" href="{{ event.noticeButtonUrl }}" target="_blank" rel="noreferrer">{{ event.noticeButtonLabel }}</a>
        <a class="btn btn--ghost magnetic" href="index.html">Back to XHOCK</a>
      </p>
    </div>
  </main>
{% endif %}

  <footer class="ticket-footer">
    <div class="container ticket-footer__inner">
      <span>© KOA. All rights reserved. · {% include "developed-by.njk" %}</span>
      <nav aria-label="Footer">
        <a href="index.html">XHOCK home</a>
        <a href="terms.html">Terms &amp; Conditions</a>
        <a href="privacy.html">Privacy Policy</a>
      </nav>
    </div>
  </footer>

{% set loadTurnstile = true %}
{% include "scripts.njk" %}
</body>
</html>

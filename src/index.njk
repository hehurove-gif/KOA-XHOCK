---
permalink: index.html
---
{% from "macros.njk" import titleLines, buyButton %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Progressive enhancement: content is visible without JS; the "js" class
       enables the scroll-entrance animations only when they can run. -->
  <script>document.documentElement.classList.add('js');window.dataLayer=window.dataLayer||[];</script>
  {%- set pageTitle = cms.home.seoTitle -%}
{%- set pageDescription = cms.home.seoDescription -%}
{%- set shareDescription = cms.home.shareDescription -%}
{%- set pagePath = "" -%}
{% include "seo.njk" %}

  <!-- Critical assets. Fonts are self-hosted: no third-party CSS on the critical path. -->
  <link rel="preload" href="assets/fonts/Orbitron-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="assets/fonts/Manrope-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" as="image" href="assets/img/hockey-hero-800.webp" imagesrcset="assets/img/hockey-hero-480.webp 480w, assets/img/hockey-hero-800.webp 800w, assets/img/hockey-hero-1200.webp 1200w" imagesizes="(max-width: 780px) 92vw, 45vw" fetchpriority="high" />
  <link rel="stylesheet" href="assets/css/styles.css" />

{% include "jsonld-event.njk" %}
  <!-- Analytics (GTM + Meta Pixel): analytics.js, loaded after interaction. -->
</head>
<body>
{% include "noscript-analytics.njk" %}
  <a class="skip-link" href="#top">Skip to main content</a>
  <noscript>
    <div class="noscript-banner" role="status">
      JavaScript is disabled in your browser. You can browse the page, but ticket checkout needs JavaScript.
      <a href="https://wa.me/{{ site.whatsappNumber }}?text=Hi%20KOA%2C%20I%27d%20like%20to%20buy%20a%20ticket%20for%20XHOCK">Buy your ticket on WhatsApp</a>.
    </div>
  </noscript>
  <div class="scroll-progress" aria-hidden="true"></div>

  <nav class="nav" aria-label="Main navigation">
    <a class="nav__brand magnetic" href="#top" aria-label="KOA XHOCK home">
      <img src="assets/logos/Logo-negativo.png" alt="KOA" width="112" height="41" />
      <span class="koa-tag">XHOCK</span>
    </a>
    <button class="nav__toggle magnetic" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primaryNav">
      <span></span><span></span>
    </button>
    <div class="nav__links" id="primaryNav">
      <a href="#boletos">{% if event.isOpen %}Tickets{% else %}Event{% endif %}</a>
      <a href="#uso">Experience</a>
      <a href="#viaje">Travel</a>
      <a href="#faq">FAQ</a>
    </div>
    {% if event.isOpen %}<a class="btn btn--small btn--primary magnetic" href="tickets.html">Buy Tickets</a>{% endif %}
  </nav>

  <main id="top" tabindex="-1">
    <section class="hero section-dark" id="hero" data-screen-label="Hero">
      <canvas class="particle-canvas" data-particles="hero" aria-hidden="true"></canvas>
      <div class="hero__noise" aria-hidden="true"></div>
      <div class="container hero__grid">
        <div class="hero__copy">
          {% include "notice.njk" %}
          <div class="badge fade-up is-visible">
            <span class="badge__dot"></span>
            {{ event.venue }} · <strong class="badge__date">{{ event.dateLabel }}</strong>
          </div>
          <h1 class="split-title hero__title">
            {{ titleLines(cms.home.hero.titleLines) }}
          </h1>
          <p class="hero__sub fade-up delay-1 is-visible">
            <strong class="hero-date">From {{ event.dateFromTo }}</strong>, {{ cms.home.hero.intro | fill }} <strong class="hero-solo">{{ cms.home.hero.solo | fill }}</strong>
          </p>
          <div class="hero__actions fade-up delay-2 is-visible">
            {{ buyButton("Buy Tickets", event, "") }}
            {% if event.isOpen %}<a class="btn btn--ghost magnetic" href="https://wa.me/{{ site.whatsappNumber }}?text=Hi%20KOA%2C%20I%27d%20like%20more%20information%20about%20XHOCK" target="_blank" rel="noreferrer">
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1.5-4.5A8.5 8.5 0 1 1 20.5 11.5z"/><path d="M8.5 9.5c0 4 2.5 6 5.5 6.5"/></svg>
              Let's chat on WhatsApp
            </a>{% endif %}
          </div>
          <div class="hero__proof fade-up delay-3 is-visible" aria-label="Trust markers">
            <span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="11" r="2.4"/></svg>{{ event.venue }}</span>
            <span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13l4-4 4 4 5-6 5 5"/><path d="M3 19h18"/></svg>Performance tracking</span>
          </div>
        </div>

        <div class="hero__visual reveal" data-parallax>
          <div class="visual-card tilt-card" data-tilt>
            <div class="visual-card__media">
              <img src="assets/img/hockey-hero-1200.webp"
                   srcset="assets/img/hockey-hero-800.webp 800w, assets/img/hockey-hero-1200.webp 1200w, assets/img/hockey-hero-1600.webp 1600w"
                   sizes="(max-width: 780px) 92vw, 45vw"
                   width="1200" height="800" fetchpriority="high" decoding="async"
                   alt="Hockey athlete competing at XHOCK" />
              <div class="media-gradient"></div>
            </div>
            <div class="visual-card__brand">
              <img src="assets/logos/Logo-isotipo-negativo.png" alt="KOA" width="349" height="144" />
            </div>
            <div class="floating-pill floating-pill--top">
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13l4-4 4 4 5-6 5 5"/><path d="M3 19h18"/></svg>
              Performance tracking
            </div>
            <div class="floating-stat floating-stat--left">
              <strong>{{ event.days }}</strong>
              <span>days</span>
            </div>
            <div class="floating-stat floating-stat--right">
              <strong>{{ event.priceLabel }}</strong>
              <span>{{ event.currency }} / ticket</span>
            </div>
          </div>
          <div class="hero__photo-strip" aria-hidden="true">
            <img src="assets/img/team-ice-480.webp" width="480" height="320" loading="lazy" decoding="async" alt="" />
            <img src="assets/img/hockey-detail-480.webp" width="480" height="320" loading="lazy" decoding="async" alt="" />
            <img src="assets/img/team-action-480.webp" width="480" height="720" loading="lazy" decoding="async" alt="" />
          </div>
        </div>
      </div>
      <a class="scroll-hint" href="#boletos" aria-label="Scroll to next section"><span></span></a>
    </section>

    <section class="marquee-section" aria-label="XHOCK highlights">
      <div class="marquee marquee--left">
        <div class="marquee__track">
          {%- for copy in [1, 2] %}{% for item in cms.home.marquee.top %}<span>{{ item | fill }}</span>{% endfor %}{% endfor %}
        </div>
      </div>
      <div class="marquee marquee--right">
        <div class="marquee__track">
          {%- for copy in [1, 2] %}{% for item in cms.home.marquee.bottom %}<span>{{ item | fill }}</span>{% endfor %}{% endfor %}
        </div>
      </div>
    </section>

    <section class="stats section-light" id="experiencia" data-screen-label="Stats">
      <canvas class="particle-canvas particle-canvas--soft" data-particles="soft" aria-hidden="true"></canvas>
      <div class="container">
        <div class="section-head section-head--center">
          <p class="eyebrow fade-up">{{ cms.home.stats.eyebrow | fill }}</p>
          <h2 class="split-title">
            {{ titleLines(cms.home.stats.titleLines) }}
          </h2>
        </div>
        <div class="stats__grid">
          <article class="stat-card stat-card--days tilt-card fade-up" data-tilt>
            <div class="stat-card__top">
              <div class="stat-card__icon"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg></div>
              <span class="stat-card__index">01</span>
            </div>
            <div class="stat-card__metric"><strong><span class="counter" data-count="{{ event.days }}">{{ event.days }}</span></strong><i>days</i></div>
            <span class="stat-card__label">Unforgettable days</span>
            <div class="event-date-badge" aria-label="Event dates {{ event.dateFromTo }}">
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
              <span>{{ event.dateShort | replace(" – ", " <small>–</small> ") | safe }}</span>
            </div>
          </article>
          <article class="stat-card stat-card--countries tilt-card fade-up delay-1" data-tilt>
            <div class="stat-card__top">
              <div class="stat-card__icon"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="11" r="2.4"/></svg></div>
              <span class="stat-card__index">02</span>
            </div>
            <span class="stat-card__label">Players From</span>
            <div class="country-flags" aria-label="Players from Canada, the United States and Mexico">
              <div>
                <svg class="flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" fill="#fff"/><rect width="7.5" height="20" fill="#d52b1e"/><rect x="22.5" width="7.5" height="20" fill="#d52b1e"/><path d="M15 4l1 2.5 2.4-.6-.8 2.1 1.7 1.3-2.1.5.3 2.3-2.5-1.2-2.5 1.2.3-2.3-2.1-.5 1.7-1.3-.8-2.1 2.4.6z" fill="#d52b1e"/></svg>
                <span>Canada</span>
              </div>
              <div>
                <svg class="flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" fill="#fff"/><g fill="#b22234"><rect width="30" height="1.54"/><rect y="3.08" width="30" height="1.54"/><rect y="6.16" width="30" height="1.54"/><rect y="9.24" width="30" height="1.54"/><rect y="12.32" width="30" height="1.54"/><rect y="15.4" width="30" height="1.54"/><rect y="18.48" width="30" height="1.52"/></g><rect width="13" height="10.78" fill="#3c3b6e"/><g fill="#fff"><circle cx="2.4" cy="2.2" r=".55"/><circle cx="5.2" cy="2.2" r=".55"/><circle cx="8" cy="2.2" r=".55"/><circle cx="10.8" cy="2.2" r=".55"/><circle cx="3.8" cy="4.2" r=".55"/><circle cx="6.6" cy="4.2" r=".55"/><circle cx="9.4" cy="4.2" r=".55"/><circle cx="2.4" cy="6.2" r=".55"/><circle cx="5.2" cy="6.2" r=".55"/><circle cx="8" cy="6.2" r=".55"/><circle cx="10.8" cy="6.2" r=".55"/><circle cx="3.8" cy="8.2" r=".55"/><circle cx="6.6" cy="8.2" r=".55"/><circle cx="9.4" cy="8.2" r=".55"/></g></svg>
                <span>United States</span>
              </div>
              <div>
                <svg class="flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="10" height="20" fill="#006847"/><rect x="10" width="10" height="20" fill="#fff"/><rect x="20" width="10" height="20" fill="#ce1126"/><circle cx="15" cy="10" r="2.1" fill="#8c6239"/><path d="M13.4 10c.6-.8 2.6-.8 3.2 0" stroke="#3f7d3a" stroke-width=".7" fill="none"/></svg>
                <span>Mexico</span>
              </div>
            </div>
          </article>
          <article class="stat-card stat-card--price tilt-card fade-up delay-2" data-tilt>
            <div class="stat-card__top">
              <div class="stat-card__icon"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7H8a3 3 0 0 0 0 6h8a3 3 0 0 1 0 6H4"/><path d="M12 4v3M12 19v3"/></svg></div>
              <span class="stat-card__index">03</span>
            </div>
            <div class="stat-card__metric"><strong>$<span class="counter" data-count="{{ event.price }}">{{ event.price }}</span></strong><i>{{ event.currency }}</i></div>
            <span class="stat-card__label">Per player ticket</span>
            <p>{{ cms.home.stats.priceBlurb | fill }}</p>
          </article>
          <article class="stat-card stat-card--venue tilt-card fade-up delay-3" data-tilt>
            <div class="stat-card__top">
              <div class="stat-card__icon"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg></div>
              <span class="stat-card__index">04</span>
            </div>
            <span class="stat-card__label">Arena Host</span>
            <picture>
              <source srcset="assets/logos/happi-arena.webp" type="image/webp" />
              <img class="happi-arena-logo" src="assets/logos/happi-arena.png" width="512" height="512" loading="lazy" decoding="async" alt="Happi Arena Cancun" />
            </picture>
          </article>
        </div>
      </div>
    </section>

    <section class="pricing section-dark" id="boletos" data-screen-label="Tickets & Registration">
      <canvas class="particle-canvas particle-canvas--form" data-particles="form" aria-hidden="true"></canvas>
      <div class="container">
        <div class="section-head section-head--center">
          {%- if event.isOpen %}
          <p class="eyebrow fade-up">{{ cms.home.tickets.eyebrow | fill }}</p>
          <h2 class="split-title">
            {{ titleLines(cms.home.tickets.titleLines) }}
          </h2>
          {%- else %}
          <p class="eyebrow fade-up">{{ event.name }}</p>
          <h2 class="split-title">
            <span class="line-wrap"><span class="line line--accent">{{ event.noticeTitle | fill }}</span></span>
          </h2>
          <p class="section-text fade-up delay-1" style="max-width:640px;margin-inline:auto;text-align:center">{{ event.noticeText | fill }}</p>
          <p class="fade-up delay-2" style="text-align:center">{{ buyButton("", event, "") }}</p>
          {%- endif %}
        </div>
        <div class="tickets-grid">
          {% if event.isOpen %}
          <div class="price-card reveal tilt-card" data-tilt>
            <span class="price-card__label">{{ cms.home.tickets.cardLabel | fill }}</span>
            <strong>{{ event.priceLabel }} <small>{{ event.currency }}</small></strong>
            <p>{{ cms.home.tickets.cardText | fill }}</p>
            <ul>
              {%- for bullet in cms.home.tickets.bullets %}
              <li>{{ bullet | fill }}</li>
              {%- endfor %}
            </ul>
            {{ buyButton(cms.home.tickets.buttonLabel, event, "") }}
          </div>
          {% endif %}
        </div>
      </div>
    </section>

    <section class="context section-dark" id="uso" data-screen-label="Use Case">
      <div class="container context__grid">
        <div class="context__media reveal" data-parallax-soft>
          <img src="assets/img/hockey-hero-1200.webp"
               srcset="assets/img/hockey-hero-800.webp 800w, assets/img/hockey-hero-1200.webp 1200w, assets/img/hockey-hero-1600.webp 1600w"
               sizes="(max-width: 900px) 92vw, 46vw"
               width="1200" height="800" loading="lazy" decoding="async"
               alt="International hockey competition at XHOCK" />
          <div class="context__quote">
            <span>Insight</span>
            <strong>{{ cms.home.context.quote | fill }}</strong>
          </div>
        </div>
        <div class="context__copy">
          <p class="eyebrow fade-up">{{ cms.home.context.eyebrow | fill }}</p>
          <h2 class="split-title">
            {{ titleLines(cms.home.context.titleLines) }}
          </h2>
          <p class="section-text fade-up delay-1">
            {{ cms.home.context.text | md | safe }}
          </p>
          {%- set pointIcons = [
  "<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z\"/><circle cx=\"12\" cy=\"11\" r=\"2.4\"/></svg>",
  "<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3.2\"/><path d=\"M3.5 19a5.5 5.5 0 0 1 11 0\"/><circle cx=\"17\" cy=\"9\" r=\"2.4\"/><path d=\"M16 13.5a4.7 4.7 0 0 1 4.5 4\"/></svg>",
  "<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 11v5M12 8h.01\"/></svg>"
] -%}
<div class="problem-list fade-up delay-2">
            {%- for point in cms.home.context.points %}
            <div>
              {{ pointIcons[loop.index0 % 3] | safe }}
              <p>{{ point | md | safe }}</p>
            </div>
            {%- endfor %}
          </div>
          <a class="text-link magnetic fade-up delay-3" href="#valor">{{ cms.home.context.link | fill }}
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="method section-light" id="valor" data-screen-label="Value Prop">
      <div class="container method__grid">
        <div class="method__copy">
          <p class="eyebrow fade-up">{{ cms.home.value.eyebrow | fill }}</p>
          <h2 class="split-title">
            {{ titleLines(cms.home.value.titleLines) }}
          </h2>
          <p class="section-text fade-up delay-1">
            {{ cms.home.value.text | md | safe }}
          </p>
          {%- set stepIcons = [
  "<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18\"/><path d=\"M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18\"/></svg>",
  "<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z\"/><circle cx=\"12\" cy=\"11\" r=\"2.4\"/></svg>",
  "<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h16v11H8l-4 3z\"/><path d=\"M8 9h8M8 12h5\"/></svg>",
  "<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3.5 19a5.5 5.5 0 0 1 11 0\"/><circle cx=\"17\" cy=\"9\" r=\"2.3\"/><path d=\"M16 13.4a4.6 4.6 0 0 1 4.5 4\"/></svg>",
  "<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.2l1-5.8L3.5 9.2l5.9-.9z\"/></svg>"
] -%}
<div class="steps fade-up delay-2">
            {%- for step in cms.home.value.steps %}
            <article class="step-card">
              <span class="step-card__num">{{ loop.index | pad2 }}</span>
              <div class="step-card__icon">{{ stepIcons[loop.index0 % 5] | safe }}</div>
              <div><h3>{{ step.title | fill }}</h3><p>{{ step.text | fill }}</p></div>
            </article>
            {%- endfor %}
          </div>
        </div>
        <div class="method__visual reveal">
          <div class="phone-card tilt-card" data-tilt>
            <img src="assets/img/team-ice-1200.webp"
                 srcset="assets/img/team-ice-480.webp 480w, assets/img/team-ice-800.webp 800w, assets/img/team-ice-1200.webp 1200w"
                 sizes="(max-width: 900px) 92vw, 46vw"
                 width="1200" height="800" loading="lazy" decoding="async"
                 alt="Hockey players competing at Happi Arena Cancun" />
            <div class="phone-card__overlay">
              <span class="koa-mark"><i class="koa-bug"></i>KOA</span>
              <p>{{ cms.home.value.overlayText | fill }}</p>
            </div>
          </div>
          <div class="method__mini-grid">
            <img src="assets/img/hockey-detail-800.webp"
                 srcset="assets/img/hockey-detail-480.webp 480w, assets/img/hockey-detail-800.webp 800w"
                 sizes="(max-width: 900px) 46vw, 23vw"
                 width="800" height="533" loading="lazy" decoding="async" alt="Hockey action detail" />
            <img src="assets/img/team-action-480.webp" width="480" height="720" loading="lazy" decoding="async" alt="Team on the ice" />
          </div>
        </div>
      </div>
    </section>

    <section class="cta-banner" id="viaje" data-screen-label="Travel & Accommodation" aria-label="Travel & Accommodation">
      <div class="cta-banner__media" data-parallax-bg>
        <img src="assets/img/team-ice-1200.webp"
             srcset="assets/img/team-ice-800.webp 800w, assets/img/team-ice-1200.webp 1200w"
             sizes="100vw" width="1200" height="800" loading="lazy" decoding="async"
             alt="Traveling to the XHOCK tournament in Cancun" />
      </div>
      <div class="cta-banner__overlay"></div>
      <div class="container cta-banner__inner">
        <p class="eyebrow fade-up">{{ cms.home.travel.eyebrow | fill }}</p>
        <h2 class="split-title cta-banner__title">
          {{ titleLines(cms.home.travel.titleLines) }}
        </h2>
        <p class="section-text fade-up delay-1" style="color:rgba(255,255,255,.78);max-width:640px;text-align:center">
          {{ cms.home.travel.text | fill }}
        </p>
        <a class="btn btn--primary magnetic fade-up delay-2" href="https://wa.me/{{ site.whatsappNumber }}?text=Hi%20KOA%2C%20I%27d%20like%20information%20about%20recommended%20hotels%20for%20XHOCK" target="_blank" rel="noreferrer">
          {{ cms.home.travel.buttonLabel | fill }}
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </section>

    <section class="faq section-dark" id="faq" data-screen-label="FAQ">
      <div class="container faq__grid">
        <div>
          <p class="eyebrow fade-up">FAQ</p>
          <h2 class="split-title">
            <span class="line-wrap"><span class="line">Frequently Asked</span></span>
            <span class="line-wrap"><span class="line line--accent">Questions.</span></span>
          </h2>
          <p class="section-text fade-up delay-1">{{ cms.faq.intro | fill }}</p>
          <a class="btn btn--ghost magnetic fade-up delay-2" href="https://wa.me/{{ site.whatsappNumber }}?text=Hi%20KOA%2C%20I%20have%20a%20question%20about%20XHOCK" target="_blank" rel="noreferrer">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1.5-4.5A8.5 8.5 0 1 1 20.5 11.5z"/><path d="M8.5 9.5c0 4 2.5 6 5.5 6.5"/></svg>
            Ask another question
          </a>
        </div>
        <div class="accordion reveal" data-accordion>
          {%- for item in cms.faq.items %}
          <article class="faq-item{% if loop.first %} active{% endif %}">
            <h3><button type="button" id="faq-q{{ loop.index }}" aria-expanded="true" aria-controls="faq-a{{ loop.index }}"><span>{{ item.question | fill }}</span><i aria-hidden="true"></i></button></h3>
            <div class="faq-panel" id="faq-a{{ loop.index }}" role="region" aria-labelledby="faq-q{{ loop.index }}"><p>{{ item.answer | fill }}</p></div>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    <section class="cta-banner" id="cta-final" data-screen-label="Final CTA" aria-label="Final CTA">
      <div class="cta-banner__media" data-parallax-bg>
        <img src="assets/img/hockey-hero-1600.webp"
             srcset="assets/img/hockey-hero-800.webp 800w, assets/img/hockey-hero-1200.webp 1200w, assets/img/hockey-hero-1600.webp 1600w"
             sizes="100vw" width="1600" height="1067" loading="lazy" decoding="async"
             alt="XHOCK international hockey tournament in Cancun" />
      </div>
      <div class="cta-banner__overlay"></div>
      <div class="container cta-banner__inner">
        <p class="eyebrow fade-up">{{ cms.home.finalCta.eyebrow | fill }}</p>
        <h2 class="split-title cta-banner__title">
          {{ titleLines(cms.home.finalCta.titleLines) }}
        </h2>
        <p class="section-text fade-up delay-1" style="color:rgba(255,255,255,.78);max-width:640px;text-align:center">
          {{ cms.home.finalCta.text | fill }}
        </p>
        {{ buyButton(cms.home.finalCta.buttonLabel, event, " fade-up delay-2") }}
      </div>
    </section>
  </main>

  <footer class="footer section-dark">
    <canvas class="particle-canvas particle-canvas--footer" data-particles="footer" aria-hidden="true"></canvas>
    <div class="container footer__grid">
      <div>
        <a class="footer__brand" href="#top" aria-label="KOA home">
          <img src="assets/logos/Logo-negativo.png" alt="KOA" width="156" height="58" />
        </a>
        <p>{{ site.footerAbout | fill }}</p>
      </div>
      <div>
        <h3>Contact</h3>
        <a href="https://wa.me/{{ site.whatsappNumber }}?text=Hi%20KOA%2C%20I%27d%20like%20more%20information%20about%20XHOCK" target="_blank" rel="noreferrer">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1.5-4.5A8.5 8.5 0 1 1 20.5 11.5z"/><path d="M8.5 9.5c0 4 2.5 6 5.5 6.5"/></svg>
          WhatsApp
        </a>
        <a href="{{ site.instagramUrl }}" target="_blank" rel="noreferrer">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
          Instagram
        </a>
        <a href="{{ site.mapsUrl }}" target="_blank" rel="noreferrer">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="11" r="2.4"/></svg>
          {{ event.venue }}
        </a>
        {% if event.isOpen %}
        <a class="footer__link-btn" href="tickets.html">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h13A1.5 1.5 0 0 1 20 8.5v1.75a1.75 1.75 0 0 0 0 3.5v1.75A1.5 1.5 0 0 1 18.5 17h-13A1.5 1.5 0 0 1 4 15.5v-1.75a1.75 1.75 0 0 0 0-3.5z"/><path d="M14.5 7.2v9.6" stroke-dasharray="2.2 2.2"/></svg>
          Buy Tickets
        </a>
        {% endif %}
      </div>
      <div>
        <h3>Legal</h3>
        <ul class="footer__legal">
          <li><a href="#faq">FAQ</a></li>
          <li><a href="privacy.html">Privacy Policy</a></li>
          <li><a href="terms.html">Terms &amp; Conditions</a></li>
          <li><button type="button" class="link-btn" data-cookie-settings>Cookie settings</button></li>
        </ul>
        <p class="legal-copy">{{ site.footerLegal | fill }}</p>
      </div>
    </div>
    <div class="footer__bottom container">
      <span>© KOA. All rights reserved.</span>
      <span>{% include "developed-by.njk" %}</span>
    </div>
  </footer>

  <!-- Single WhatsApp entry point: no data is collected here, so visitors are
       never asked for the same details twice (QA-016 / QA-022). -->

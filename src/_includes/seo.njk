{# Variables de la página: pageTitle, pageDescription, pagePath, shareTitle, shareDescription, noindex #}
  <title>{{ pageTitle | fill }}</title>
  <meta name="description" content="{{ pageDescription | fill }}" />
  <link rel="icon" type="image/png" href="assets/favicon.png" />
  <link rel="canonical" href="{{ pagePath | absUrl }}" />
  <meta name="robots" content="{% if noindex %}noindex,follow{% else %}index,follow{% endif %}" />
  <meta name="theme-color" content="#050505" />

  <!-- Social sharing (WhatsApp / Instagram / X) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.brand }}" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content="{{ pagePath | absUrl }}" />
  <meta property="og:title" content="{{ (shareTitle or pageTitle) | fill }}" />
  <meta property="og:description" content="{{ (shareDescription or pageDescription) | fill }}" />
  <meta property="og:image" content="{{ site.ogImage | absUrl }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Hockey player competing at XHOCK in Cancun" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ (shareTitle or pageTitle) | fill }}" />
  <meta name="twitter:description" content="{{ (shareDescription or pageDescription) | fill }}" />
  <meta name="twitter:image" content="{{ site.ogImage | absUrl }}" />
  <script>(function(){try{var q=new URLSearchParams(location.search).get('lang');var l=(q==='es'||q==='en')?q:localStorage.getItem('koa-lang');if(l==='es'){var d=document.documentElement;d.lang='es';d.dataset.lang='es';setTimeout(function(){d.classList.add('i18n-ready')},1500)}}catch(e){}})()</script>
